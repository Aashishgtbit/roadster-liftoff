{
  "name": "roadster-liftoff",
  "version": "2.1.0",
  "description": "Fan-made, physics-simulated 3D take on the Tesla Roadster flying-car unveiling: watch or fly the ramp hang and lineup jump, or race a random night course. TypeScript, three.js, Vite.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "0.165.0"
  },
  "devDependencies": {
    "@types/node": "20.19.40",
    "@types/three": "0.165.0",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
